def _require_gate_common():
    """Return gate_common, or fail clearly (v0.4.8 fix pass,
    secondary review item 14). The pattern helpers genuinely
    need gate_common's loader/discovery; when it is missing or
    broken they must name the missing module instead of dying
    with a traceback. Commands that reach these helpers today
    are cmd_env and cmd_override; the recovery commands
    (cmd_enforce, cmd_uninstall, cmd_checks) never reach them
    and run with gate_common=None."""
    if gate_common is None:
        say("tools/gate_common.py is missing or could not be "
            "imported, so this command cannot load or discover "
            "pattern lists"
            + (f" ({_GATE_COMMON_IMPORT_ERROR})"
               if _GATE_COMMON_IMPORT_ERROR else "")
            + ". Restore gate_common.py in the tooling "
            "checkout's tools/ directory and re-run. Recovery "
            "commands that do not need it (enforce, uninstall, "
            "checks) still work.")
        raise SystemExit(2)
    return gate_common


def _sanitize(text):
    """Make a line safe to print on the owner's terminal: escape
    every non-printable / non-ASCII character (ANSI escapes, control
    characters) so a crafted commit cannot hide or fake matches."""
    return "".join(ch if 32 <= ord(ch) < 127 else
                   f"\\x{ord(ch):02x}" if ord(ch) < 256 else
                   f"\\u{ord(ch):04x}" for ch in text)


def _pattern_files(tooling):
    """The pattern files in force for LOCAL checks — the one
    discovery rule (gate_common's): $GATE_PATTERNS_FILE when set
    (os.pathsep-joined), else the tooling root's
    patterns-strict.txt and patterns-relaxed.txt."""
    return _require_gate_common().discover_pattern_files(
        tooling, os.environ.get("GATE_PATTERNS_FILE"))


def _load_pattern_files(paths):
    """Union of the pattern strings across files, in order,
    deduplicated (a pattern in both lists counts once) —
    gate_common's loader without compilation (this CLI only
    counts and displays patterns; the gate compiles)."""
    pats, _errors = _require_gate_common().load_patterns(
        paths, compile=False)
    return [p["raw"] for p in pats]


def _load_patterns_tagged(paths):
    """Like _load_pattern_files, but each entry keeps its tier,
    its 1-based number among the pattern lines of its own file,
    and its source path — the same (tier, number) the gate
    reports, from gate_common's one loader."""
    pats, _errors = _require_gate_common().load_patterns(
        paths, compile=False)
    return pats


def cmd_setup(tooling, args):
    out = os.path.join(tooling, "patterns-relaxed.txt")
    if os.path.exists(out) and not args.force:
        say("patterns-relaxed.txt already exists in the tooling "
            "checkout — refusing to overwrite it. Edit it directly, "
            "or re-run with --force to replace it.")
        return 1
    user = getpass.getuser()
    # ANY answer given as a flag — including the --no-* flags —
    # makes the run non-interactive (v0.4.8, pass 4: the --no-*
    # flags were excluded from this test, so `repo-kit setup
    # --no-gmail` alone dropped into the interview, which then
    # overwrote the flag's answer with whatever the interview
    # produced).
    interactive = not any([args.email, args.domain, args.handle,
                           args.name, args.age_key, args.no_gmail,
                           args.no_tailnet, args.no_paths])
    emails, domains, handles, names = (
        list(args.email), list(args.domain), list(args.handle),
        list(args.name))
    age_key = args.age_key
    want_gmail, want_tailnet, want_paths = (
        not args.no_gmail, not args.no_tailnet, not args.no_paths)
    if interactive:
        print("repo-kit setup — your private pattern list.")
        print("Answer what applies; press Enter to skip a question. "
              "Values become patterns in patterns-relaxed.txt "
              "(tooling root, git-ignored). Nothing is uploaded "
              "anywhere.\n")
        answers = [
            _ask_list("Your email addresses (comma-separated): "),
            _ask_list(
                "Domains you own, to block any address at them "
                "(comma-separated): "),
            _ask("Also block ANY @gmail.com address in your "
                 "repos? [Y/n] "),
            _ask_list(
                "Your usernames/handles on other services "
                "(comma-separated): "),
            _ask_list(
                "Names unique to your setup — cloud project IDs, "
                "drive or server names (comma-separated): "),
            _ask(f"Block your home paths (/Users/{user}/ and "
                 f"/home/{user}/)? [Y/n] "),
            _ask("Block Tailscale tailnet names? [Y/n] "),
            _ask("A sops age PUBLIC key (age1…), if you use "
                 "one — it is an identifier uniquely yours "
                 "(Enter to skip): "),
        ]
        if any(a is None for a in answers):
            # The input ended mid-interview (v0.4.8, pass 4):
            # the old code read EOF as "" and "" as YES for the
            # three broad questions, so a run with stdin closed
            # wrote a list blocking any @gmail.com address, all
            # tailnet names and the user's home paths with no
            # human having answered anything. Abort instead —
            # nothing is written.
            say("setup aborted — the input ended before every "
                "question was answered, so no answers were "
                "recorded and NOTHING was written. Run setup in "
                "a terminal, or pass the answers as flags "
                "(--email/--domain/--handle/--name/--age-key, "
                "--no-gmail/--no-tailnet/--no-paths).")
            return 2
        (emails, domains, gmail_a, handles, names, paths_a,
         tailnet_a, age_a) = answers
        want_gmail = gmail_a.lower() not in ("n", "no")
        want_paths = paths_a.lower() not in ("n", "no")
        want_tailnet = tailnet_a.lower() not in ("n", "no")
        age_key = age_a or None

    lines = ["# patterns-relaxed.txt — MY private pattern list.",
             "# Built by `repo-kit setup`. Edit freely: one regex per "
             "line,",
             "# # starts a comment, matching is case-insensitive.",
             "# NEVER commit this file anywhere (the tooling repo's",
             "# .gitignore covers it here). For CI, `repo-kit "
             "provision`",
             "# uploads its contents as the GATE_PATTERNS repository",
             "# secret. An optional patterns-strict.txt beside it (a",
             "# stricter list you keep by hand) ADDS its patterns to",
             "# this file's for LOCAL checks only — never instead of",
             "# them, so the two files cannot drift apart — and is",
             "# never uploaded anywhere.", ""]
    pats = []

    def add(section, values):
        if values:
            lines.append(f"# {section}")
            lines.extend(values)
            lines.append("")
            pats.extend(values)

    add("Email addresses (mine)",
        [re.escape(e) for e in emails])
    add("My domains — any address at them",
        [r"[\w.+-]+@" + re.escape(d) for d in domains])
    if want_gmail:
        add("Webmail catch-all", [r"[\w.+-]+@gmail\.com"])
    add("Handles / usernames", [re.escape(h) for h in handles])
    add("My infrastructure names (cloud projects, drives, servers)",
        [re.escape(n) for n in names])
    if want_paths:
        add("My machine paths",
            [f"/Users/{user}/", f"/home/{user}/"])
    if want_tailnet:
        add("Tailnet names", [r"[a-z0-9-]+\.ts\.net"])
    if age_key:
        add("My age public key (identifier)", ["age1[a-z0-9]{58}"]
            if not age_key.startswith("age1") else [re.escape(age_key)])

    bad = []
    for p in pats:
        try:
            re.compile(p, re.IGNORECASE)
        except re.error as exc:
            bad.append(f"{p}: {exc}")
    if bad:
        say("these generated patterns do not compile — nothing written:")
        for b in bad:
            print(f"  {b}")
        return 1
    # The list is the user's most identifying file — written
    # 0600 like enforced.env (v0.4.8, pass 4: this was a plain
    # open(), leaving the umask's default, usually world-readable).
    fd = os.open(out, os.O_WRONLY | os.O_CREAT | os.O_TRUNC,
                 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write("\n".join(lines))
    os.chmod(out, 0o600)  # a pre-existing file keeps its old mode
    # under O_TRUNC alone; pin it explicitly
    # Standard closing summary for every guided setup (pattern agreed
    # 2026-11-12): say what was written, WHERE it lives, that it can be
    # edited by hand anytime, and the one next step if there is one.
    print()
    print("=" * 64)
    print("Setup complete.")
    print(f"  Wrote:    {out} ({len(pats)} patterns)")
    print("  What reads it: the pre-push checks and (via the secret "
          "below) CI.")
    print("  Edit it anytime: it's a plain text file — one regex per "
          "line,")
    print("  # for comments. Your edits take effect on the next check; "
          "no need")
    print("  to re-run setup. Re-running setup replaces it (with "
          "--force).")
    print("  Keep it private: it stays out of git (the tooling repo's "
          ".gitignore")
    print("  covers it) — never copy it into a project repo.")
    print("  Stricter local list (optional): create patterns-strict.txt")
    print("  beside it in the tooling root — same format — and local")
    print("  checks ADD its patterns to this file's (never instead of")
    print("  them, so the two can't drift). It never leaves this")
    print("  machine: CI only ever receives the relaxed list.")
    print("  Next step: run `repo-kit provision OWNER/REPO` for each "
          "project")
    print("  repo — it sets the GATE_PATTERNS secret from this file, "
          "so CI")
    print("  enforces the same list.")
    print("=" * 64)
    return 0


