#!/usr/bin/env python3
"""repo-kit — the repo-tooling installer. ONE entry point, six jobs:

    repo-kit init  [--tooling PATH] [REPO]
        Scaffold a repo from the tooling templates: PLAN.md,
        project.public.yaml, CONTRIBUTING.md, adr/ format files and the
        thin caller workflows — copying ONLY what belongs in a project
        repo — then merge the tooling block into .gitignore and install
        the hooks. Existing project CONTENT files are never overwritten;
        managed files (workflows) are only written when absent, so
        re-running init is safe and reports what it skipped.

    repo-kit hooks [--tooling PATH] [REPO]
        Install/refresh .git/hooks/pre-push (the dispatcher). This is
        also the "update" path for local checks: the dispatcher reads
        the tooling checkout at push time, so new checks added to the
        toolkit apply as soon as the tooling checkout is updated.

    repo-kit setup [--tooling PATH] [--force] [answer flags]
        Guided questionnaire that builds your private patterns.txt in
        the tooling checkout root (see "Your pattern list" in the
        tooling README). Interactive prompts with detected defaults
        (your OS username, home paths); every prompt has a matching
        flag (--email, --domain, --handle, --name, --age-key,
        --no-paths, --no-gmail, --no-tailnet) so the same setup is
        scriptable and testable. Refuses to overwrite an existing
        patterns.txt without --force.

    repo-kit provision OWNER/REPO [--variant A|B] [--dry-run]
        Apply the GitHub setup standard to a public repo through the
        `gh` CLI / `gh api`: repository settings (squash-only merges,
        auto-delete head branches, wiki/projects/discussions off unless
        --keep-*), the free security stack (secret scanning + push
        protection, Dependabot alerts + security updates, CodeQL
        default setup, private vulnerability reporting), Actions
        hardening (read-only default workflow token, approval for
        first-time contributors' fork workflows), and the
        `default-branch` ruleset from templates/rulesets/ (variant A:
        solo repo, required approvals 0; variant B: an agent or outside
        developer holds a write token — 1 approval + Code Owner review,
        with --bypass-user-id putting the owner on the bypass list in
        pull-request mode). Idempotent: an existing ruleset of the same
        name is updated in place, never duplicated. --dry-run prints
        every command and payload and executes nothing.

    repo-kit packet [packet options]
        Build a review packet (tools/review_packet.py): one
        self-contained markdown file covering a commit range — commit
        list, per-commit stats, diff, full changed-file texts — ready
        to hand to any reviewer. Packets land in the repo's
        review/packets/ folder (local-only, kept out of commits by
        review/.gitignore; reviewer feedback goes in review/feedback/).
        The tool remembers the last 10 packet endpoints in .git:
        --history lists them, --rollback N rewinds the memory N packets
        (for a packet generated but never sent), --reset clears it,
        --base REF starts one packet at a custom ref. Every packet is
        pattern-scanned after generation (warnings only). All packet
        options pass through: `repo-kit packet --help` shows them.

--tooling names a local tooling checkout in v0.1; fetching templates
from a git URL (sparse checkout of templates/ + install/ + hooks/) is
the planned distribution once the tooling repo is published.
"""

import argparse
import getpass
import json
import os
import re
import shlex
import shutil
import subprocess
import sys

CONTENT_FILES = ["PLAN.md", "project.public.yaml", "CONTRIBUTING.md"]
ADR_FILES = ["adr/ADR-FORMAT.md", "adr/ADR-000-template.json"]
WORKFLOW_FILES = ["dashboard.yml", "gate.yml"]
BLOCK_BEGIN = "# >>> repo-tooling"
BLOCK_END = "# <<< repo-tooling"


def say(msg):
    print(f"repo-kit: {msg}")


def copy_if_absent(src, dst, label):
    if os.path.exists(dst):
        say(f"skip {label} (exists — project content is never overwritten)")
        return False
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    shutil.copyfile(src, dst)
    say(f"wrote {label}")
    return True


def merge_gitignore(tooling, repo):
    block = open(os.path.join(tooling, "templates", "gitignore.block"),
                 encoding="utf-8").read().strip("\n")
    path = os.path.join(repo, ".gitignore")
    existing = ""
    if os.path.exists(path):
        existing = open(path, encoding="utf-8").read()
    if BLOCK_BEGIN in existing and BLOCK_END in existing:
        head, _, rest = existing.partition(BLOCK_BEGIN)
        _, _, tail = rest.partition(BLOCK_END)
        merged = head.rstrip("\n") + "\n\n" + block + \
            (("\n" + tail) if tail.strip("\n") else "\n")
        action = "refreshed tooling block in"
    elif existing.strip():
        merged = existing.rstrip("\n") + "\n\n" + block + "\n"
        action = "appended tooling block to"
    else:
        merged = block + "\n"
        action = "created"
    if merged != existing:
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(merged)
        say(f"{action} .gitignore")
    else:
        say(".gitignore tooling block unchanged")


def install_hooks(tooling, repo):
    git_dir = subprocess.run(
        ["git", "-C", repo, "rev-parse", "--git-dir"],
        capture_output=True, text=True)
    if git_dir.returncode != 0:
        say("not a git repo — run `git init` first; hooks skipped")
        return
    hooks_dir = os.path.join(repo, git_dir.stdout.strip(), "hooks")
    os.makedirs(hooks_dir, exist_ok=True)
    dst = os.path.join(hooks_dir, "pre-push")
    src_text = open(os.path.join(tooling, "hooks", "pre-push"),
                    encoding="utf-8").read()
    baked = src_text.replace("__TOOLING_HOME__", os.path.abspath(tooling))
    if os.path.exists(dst):
        current = open(dst, encoding="utf-8").read()
        if "repo-tooling pre-push dispatcher" not in current:
            say("REFUSED: .git/hooks/pre-push exists and is not the "
                "repo-tooling dispatcher — merge it by hand, not replaced")
            return
        if current == baked:
            say("pre-push hook unchanged")
            return
    with open(dst, "w", encoding="utf-8") as fh:
        fh.write(baked)
    os.chmod(dst, 0o755)
    say("installed .git/hooks/pre-push (dispatcher)")


def _ask(prompt):
    try:
        return input(prompt).strip()
    except EOFError:
        return ""


def _ask_list(prompt):
    raw = _ask(prompt)
    return [v.strip() for v in raw.split(",") if v.strip()]


def cmd_setup(tooling, args):
    out = os.path.join(tooling, "patterns.txt")
    if os.path.exists(out) and not args.force:
        say("patterns.txt already exists in the tooling checkout — "
            "refusing to overwrite it. Edit it directly, or re-run "
            "with --force to replace it.")
        return 1
    user = getpass.getuser()
    interactive = not any([args.email, args.domain, args.handle,
                           args.name, args.age_key])
    emails, domains, handles, names = (
        list(args.email), list(args.domain), list(args.handle),
        list(args.name))
    age_key = args.age_key
    want_gmail, want_tailnet, want_paths = (
        not args.no_gmail, not args.no_tailnet, not args.no_paths)
    if interactive:
        print("repo-kit setup — your private pattern list.")
        print("Answer what applies; press Enter to skip a question. "
              "Values become patterns in patterns.txt (tooling root, "
              "git-ignored). Nothing is uploaded anywhere.\n")
        emails = _ask_list("Your email addresses (comma-separated): ")
        domains = _ask_list(
            "Domains you own, to block any address at them "
            "(comma-separated): ")
        want_gmail = _ask(
            "Also block ANY @gmail.com address in your repos? [Y/n] "
            ).lower() not in ("n", "no")
        handles = _ask_list(
            "Your usernames/handles on other services "
            "(comma-separated): ")
        names = _ask_list(
            "Names unique to your setup — cloud project IDs, drive or "
            "server names (comma-separated): ")
        want_paths = _ask(
            f"Block your home paths (/Users/{user}/ and "
            f"/home/{user}/)? [Y/n] ").lower() not in ("n", "no")
        want_tailnet = _ask(
            "Block Tailscale tailnet names (*.ts.net)? [Y/n] "
            ).lower() not in ("n", "no")
        age_key = _ask(
            "A sops age PUBLIC key (age1…), if you use one — it is an "
            "identifier uniquely yours (Enter to skip): ") or None

    lines = ["# patterns.txt — MY private pattern list.",
             "# Built by `repo-kit setup`. Edit freely: one regex per "
             "line,",
             "# # starts a comment, matching is case-insensitive.",
             "# NEVER commit this file anywhere (the tooling repo's",
             "# .gitignore covers it here). For CI, paste its contents",
             "# into the GATE_PATTERNS repository secret.", ""]
    pats = []

    def add(section, values):
        if values:
            lines.append(f"# {section}")
            lines.extend(values)
            lines.append("")
            pats.extend(values)

    add("Email addresses (mine)",
        [re.escape(e) for e in emails])
    add("My domains — any address at them",
        [r"[\w.+-]+@" + re.escape(d) for d in domains])
    if want_gmail:
        add("Webmail catch-all", [r"[\w.+-]+@gmail\.com"])
    add("Handles / usernames", [re.escape(h) for h in handles])
    add("My infrastructure names (cloud projects, drives, servers)",
        [re.escape(n) for n in names])
    if want_paths:
        add("My machine paths",
            [f"/Users/{user}/", f"/home/{user}/"])
    if want_tailnet:
        add("Tailnet names", [r"[a-z0-9-]+\.ts\.net"])
    if age_key:
        add("My age public key (identifier)", ["age1[a-z0-9]{58}"]
            if not age_key.startswith("age1") else [re.escape(age_key)])

    bad = []
    for p in pats:
        try:
            re.compile(p, re.IGNORECASE)
        except re.error as exc:
            bad.append(f"{p}: {exc}")
    if bad:
        say("these generated patterns do not compile — nothing written:")
        for b in bad:
            print(f"  {b}")
        return 1
    with open(out, "w", encoding="utf-8") as fh:
        fh.write("\n".join(lines))
    # Standard closing summary for every guided setup (pattern agreed
    # 2026-11-12): say what was written, WHERE it lives, that it can be
    # edited by hand anytime, and the one next step if there is one.
    print()
    print("=" * 64)
    print("Setup complete.")
    print(f"  Wrote:    {out} ({len(pats)} patterns)")
    print("  What reads it: the pre-push checks and (via the secret "
          "below) CI.")
    print("  Edit it anytime: it's a plain text file — one regex per "
          "line,")
    print("  # for comments. Your edits take effect on the next check; "
          "no need")
    print("  to re-run setup. Re-running setup replaces it (with "
          "--force).")
    print("  Keep it private: it stays out of git (the tooling repo's "
          ".gitignore")
    print("  covers it) — never copy it into a project repo.")
    print("  Next step: in each project repo, add a secret named "
          "GATE_PATTERNS")
    print("  with this file's contents, so CI enforces the same list.")
    print("=" * 64)
    return 0


ENV_TOOLS = [
    ("gitleaks", ["gitleaks", "version"], "secret scanning"),
    ("shellcheck", ["shellcheck", "--version"], "shell script linting"),
    ("zizmor", ["zizmor", "--version"], "Actions workflow security lint"),
    ("actionlint", ["actionlint", "--version"], "Actions workflow lint"),
    ("check-merge-conflict", ["check-merge-conflict", "--help"],
     "file hygiene (pre-commit-hooks package)"),
    ("python3", ["python3", "--version"], "renderer + checks runtime"),
]


def cmd_env(tooling, args):
    """Environment report + optional bulk hook install.

    Designed to be callable from a dev container's entrypoint: fast,
    idempotent, and fail-open (exit 0) unless --strict — a tooling
    problem must never stop the user's shell from starting.
    """
    print("repo-kit env — tooling status")
    for name, cmd, role in ENV_TOOLS:
        path = shutil.which(cmd[0])
        if not path:
            print(f"  MISSING  {name} ({role}) — checks that need it "
                  "skip loudly")
            continue
        try:
            out = subprocess.run(cmd, capture_output=True, text=True,
                                 timeout=10)
            ver = (out.stdout or out.stderr).strip().splitlines()
            ver = ver[0] if ver else "ok"
        except Exception as exc:  # noqa: BLE001 — report, never crash env
            ver = f"present but errored: {exc}"
        print(f"  ok       {name}: {ver}")
    pats = os.path.join(tooling, "patterns.txt")
    if os.path.exists(pats):
        n = sum(1 for ln in open(pats, encoding="utf-8")
                if ln.strip() and not ln.startswith("#"))
        print(f"  patterns.txt: present ({n} patterns)")
    else:
        print("  patterns.txt: ABSENT — run `repo-kit setup`")
    if args.hooks_root:
        root = os.path.abspath(args.hooks_root)
        found = []
        for dirpath, dirnames, _ in os.walk(root):
            if ".git" in dirnames:
                found.append(dirpath)
                dirnames[:] = []  # don't descend into a repo
            if dirpath[len(root):].count(os.sep) > 3:
                dirnames[:] = []
        if not found:
            print(f"  hooks: no git repos found under {root}")
        for repo in sorted(found):
            print(f"  hooks -> {repo}")
            install_hooks(tooling, repo)
    return 0


RULESET_NAME = "default-branch"


def _gh_api(method, path, payload=None):
    """One `gh api` call. Returns (returncode, stdout, stderr)."""
    cmd = ["gh", "api", "--method", method, path]
    data = None
    if payload is not None:
        cmd += ["--input", "-"]
        data = json.dumps(payload)
    proc = subprocess.run(cmd, input=data, capture_output=True,
                          text=True)
    return proc.returncode, proc.stdout, proc.stderr


def _provision_steps(args, owner, repo):
    """The settings/security API calls of the standard, in order.

    Each step is (label, method, path, payload-or-None). The ruleset
    is handled separately in cmd_provision: whether it is a create or
    an update depends on what already exists on the repo.
    """
    base = f"repos/{owner}/{repo}"
    settings = {
        # Squash-only merges: one clean conventional-commit subject per
        # change on main (the dashboard renderer derives the activity
        # feed from those subjects). Merged PR branches delete
        # themselves. Unused surfaces off unless --keep-*.
        "allow_squash_merge": True,
        "allow_merge_commit": False,
        "allow_rebase_merge": False,
        "delete_branch_on_merge": True,
        "has_wiki": bool(args.keep_wiki),
        "has_projects": bool(args.keep_projects),
        "has_discussions": bool(args.keep_discussions),
        "security_and_analysis": {
            "secret_scanning": {"status": "enabled"},
            "secret_scanning_push_protection": {"status": "enabled"},
            "dependabot_security_updates": {"status": "enabled"},
        },
    }
    return [
        ("repository settings (squash-only merges, auto-delete head "
         "branches, unused surfaces off, secret scanning + push "
         "protection, Dependabot security updates)",
         "PATCH", base, settings),
        ("Dependabot alerts", "PUT",
         f"{base}/vulnerability-alerts", None),
        ("private vulnerability reporting", "PUT",
         f"{base}/private-vulnerability-reporting", None),
        ("CodeQL code scanning (default setup)", "PATCH",
         f"{base}/code-scanning/default-setup",
         {"state": "configured", "query_suite": "default"}),
        ("Actions: default workflow token read-only", "PUT",
         f"{base}/actions/permissions/workflow",
         {"default_workflow_permissions": "read",
          "can_approve_pull_request_reviews": False}),
        ("Actions: approval for first-time contributors' fork "
         "workflows", "PUT",
         f"{base}/actions/permissions/fork-pr-contributor-approval",
         {"approval_policy": "first_time_contributors"}),
    ]


def _load_ruleset(tooling, args):
    path = os.path.join(tooling, "templates", "rulesets",
                        f"variant-{args.variant.lower()}.json")
    with open(path, encoding="utf-8") as fh:
        ruleset = json.load(fh)
    if args.required_check:
        checks = [{"context": c} for c in args.required_check]
        for rule in ruleset["rules"]:
            if rule["type"] == "required_status_checks":
                rule["parameters"]["required_status_checks"] = checks
    if args.bypass_user_id:
        # Variant B per the standard: the owner bypasses in
        # pull-request mode only, so he can merge his own work while
        # the approval rule binds everyone else.
        ruleset["bypass_actors"] = [{
            "actor_id": args.bypass_user_id,
            "actor_type": "User",
            "bypass_mode": "pull_request",
        }]
    return ruleset


def _infer_target():
    """OWNER/REPO from the current directory's git origin remote."""
    proc = subprocess.run(["git", "remote", "get-url", "origin"],
                          capture_output=True, text=True)
    if proc.returncode != 0:
        return None
    m = re.search(r"github\.com[:/]([\w.-]+)/([\w.-]+?)(?:\.git)?$",
                  proc.stdout.strip())
    return f"{m.group(1)}/{m.group(2)}" if m else None


def cmd_provision(tooling, args):
    target = args.target
    if not target:
        target = _infer_target()
        if target:
            say(f"no target given — using {target} (from this "
                "directory's git origin remote)")
    m = re.fullmatch(r"([\w.-]+)/([\w.-]+)", target or "")
    if not m:
        say("target must be OWNER/REPO, e.g. "
            "repo-kit provision octocat/hello-world --dry-run — "
            "or run inside a clone whose origin is on GitHub")
        return 2
    owner, repo = m.groups()
    base = f"repos/{owner}/{repo}"
    steps = _provision_steps(args, owner, repo)
    ruleset = _load_ruleset(tooling, args)

    def show(method, path, payload):
        cmd = ["gh", "api", "--method", method, path]
        if payload is not None:
            cmd += ["--input", "-"]
        print(f"  $ {shlex.join(cmd)}")
        if payload is not None:
            body = json.dumps(payload, indent=2)
            print("\n".join(f"    {ln}" for ln in body.splitlines()))

    if args.dry_run:
        print(f"repo-kit provision — DRY RUN for {owner}/{repo} "
              f"(ruleset variant {args.variant}). Nothing will be "
              "executed; no network calls are made.")
        for label, method, path, payload in steps:
            print(f"\n# {label}")
            show(method, path, payload)
        print(f"\n# ruleset '{RULESET_NAME}' on the default branch — "
              "idempotent: looked up by name first, then created or "
              "updated in place (never duplicated)")
        show("GET", f"{base}/rulesets", None)
        print(f"  … if no ruleset named '{RULESET_NAME}' exists:")
        print(f"      POST   {base}/rulesets")
        print(f"  … if one exists (id <id>):")
        print(f"      PUT    {base}/rulesets/<id>")
        print("  … with this payload:")
        body = json.dumps(ruleset, indent=2)
        print("\n".join(f"    {ln}" for ln in body.splitlines()))
        if args.variant == "B" and not args.bypass_user_id:
            print("\n  NOTE (variant B): at run time (not in a dry "
                  "run) your numeric GitHub user id is resolved "
                  "automatically from the authenticated gh user and "
                  "added to the ruleset bypass list in pull-request "
                  "mode, so you can merge your own PRs while the "
                  "approval rule binds token holders. Pass "
                  "--bypass-user-id to pin a specific id instead.")
        print("\nDry run only — no commands were executed.")
        return 0

    if not shutil.which("gh"):
        say("the GitHub CLI (`gh`) is required for provisioning — "
            "install it and run `gh auth login` first")
        return 2
    if args.variant == "B" and not args.bypass_user_id:
        rc, out, err = _gh_api("GET", "user", None)
        uid = None
        if rc == 0:
            try:
                uid = int(json.loads(out)["id"])
            except (ValueError, KeyError, TypeError):
                uid = None
        if not uid:
            say("variant B needs your numeric GitHub user id for "
                "the ruleset bypass list, and `gh api user` did not "
                "return one — check `gh auth status`, or pass "
                "--bypass-user-id explicitly")
            return 2
        args.bypass_user_id = uid
        ruleset = _load_ruleset(tooling, args)
        say(f"variant B: bypass actor = you (GitHub user id {uid}, "
            "resolved from the authenticated gh user)")
    for label, method, path, payload in steps:
        rc, out, err = _gh_api(method, path, payload)
        if rc != 0:
            say(f"FAILED at '{label}': {(err or out).strip()}")
            return 1
        say(f"ok — {label}")
    rc, out, err = _gh_api("GET", f"{base}/rulesets?per_page=100")
    if rc != 0:
        say(f"FAILED listing existing rulesets: {(err or out).strip()}")
        return 1
    try:
        existing = [r for r in json.loads(out or "[]")
                    if r.get("name") == RULESET_NAME]
    except ValueError:
        say("could not parse the ruleset list GitHub returned — "
            "stopping rather than risk a duplicate ruleset")
        return 1
    if existing:
        rid = existing[0]["id"]
        rc, out, err = _gh_api("PUT", f"{base}/rulesets/{rid}", ruleset)
        action = f"updated in place (id {rid}) — no duplicate created"
    else:
        rc, out, err = _gh_api("POST", f"{base}/rulesets", ruleset)
        action = "created"
    if rc != 0:
        say(f"FAILED applying the ruleset: {(err or out).strip()}")
        return 1
    say(f"ok — ruleset '{RULESET_NAME}' (variant {args.variant}) "
        f"{action}")
    say(f"done — {owner}/{repo} matches the GitHub setup standard. "
        "Re-run anytime to re-apply or audit; it is idempotent.")
    return 0


def cmd_init(tooling, repo):
    for rel in CONTENT_FILES + ADR_FILES:
        copy_if_absent(os.path.join(tooling, "templates", rel),
                       os.path.join(repo, rel), rel)
    for name in WORKFLOW_FILES:
        copy_if_absent(
            os.path.join(tooling, "templates", "workflows", name),
            os.path.join(repo, ".github", "workflows", name),
            f".github/workflows/{name}")
    copy_if_absent(os.path.join(tooling, "templates", "review",
                                ".gitignore"),
                   os.path.join(repo, "review", ".gitignore"),
                   "review/.gitignore")
    for sub in ("packets", "feedback"):
        os.makedirs(os.path.join(repo, "review", sub), exist_ok=True)
    say("review/ seeded: packets + feedback folders (local-only — "
        "everything under review/ except its .gitignore is ignored)")
    merge_gitignore(tooling, repo)
    install_hooks(tooling, repo)
    say("done. Next: edit project.public.yaml + PLAN.md, add the "
        "GATE_PATTERNS repo secret, enable Pages (source: GitHub Actions).")


def cmd_packet_dispatch(rest):
    """`repo-kit packet ...` — forwarded to tools/review_packet.py.

    Handled outside argparse on purpose: the packet tool has its own
    option set, and argparse would reject the tool's flags as
    unrecognized instead of passing them through. An optional
    --tooling PATH (or --tooling=PATH) anywhere in the arguments is
    consumed here; everything else reaches the packet tool verbatim.
    """
    tooling = os.path.dirname(os.path.dirname(
        os.path.realpath(__file__)))
    forwarded = []
    i = 0
    while i < len(rest):
        arg = rest[i]
        if arg == "--tooling" and i + 1 < len(rest):
            tooling = rest[i + 1]
            i += 2
        elif arg.startswith("--tooling="):
            tooling = arg.split("=", 1)[1]
            i += 1
        else:
            forwarded.append(arg)
            i += 1
    tooling = os.path.abspath(tooling)
    script = os.path.join(tooling, "tools", "review_packet.py")
    if not os.path.exists(script):
        say(f"packet tool not found at {script}")
        return 2
    proc = subprocess.run([sys.executable, script, *forwarded])
    return proc.returncode


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and argv[0] == "packet":
        return cmd_packet_dispatch(argv[1:])
    default_tooling = os.path.dirname(os.path.dirname(
        os.path.realpath(__file__)))
    ap = argparse.ArgumentParser(
        description=__doc__,
        epilog="packet: build a review packet for a commit range — "
               "run `repo-kit packet --help` for its options (it is "
               "dispatched separately; its flags pass through).")
    sub = ap.add_subparsers(dest="command", required=True,
                            metavar="{init,hooks,env,setup,provision,"
                                    "packet}")
    for name in ("init", "hooks"):
        sp = sub.add_parser(name)
        sp.add_argument("repo", nargs="?", default=".")
        sp.add_argument("--tooling", default=default_tooling)
    sp = sub.add_parser("env")
    sp.add_argument("--tooling", default=default_tooling)
    sp.add_argument("--hooks-root",
                    help="install/refresh hooks in every git repo under "
                         "this directory (dev-container entrypoint use)")
    sp = sub.add_parser("setup")
    sp.add_argument("--tooling", default=default_tooling)
    sp.add_argument("--force", action="store_true",
                    help="replace an existing patterns.txt")
    sp.add_argument("--email", action="append", default=[])
    sp.add_argument("--domain", action="append", default=[])
    sp.add_argument("--handle", action="append", default=[])
    sp.add_argument("--name", action="append", default=[])
    sp.add_argument("--age-key", default=None)
    sp.add_argument("--no-gmail", action="store_true")
    sp.add_argument("--no-tailnet", action="store_true")
    sp.add_argument("--no-paths", action="store_true")
    sp = sub.add_parser("provision")
    sp.add_argument("target", nargs="?", default=None,
                    help="OWNER/REPO of the GitHub repo to bring up to "
                         "the setup standard (default: inferred from "
                         "the current directory's git origin remote)")
    sp.add_argument("--tooling", default=default_tooling)
    sp.add_argument("--variant", choices=["A", "B"], default="A",
                    help="ruleset variant: A = solo repo, no agent or "
                         "outside developer holds a write token "
                         "(required approvals 0); B = a write token is "
                         "held by an agent/outside developer (required "
                         "approvals 1 + Code Owner review)")
    sp.add_argument("--dry-run", action="store_true",
                    help="print every gh command and API payload that "
                         "WOULD run; execute nothing, no network")
    sp.add_argument("--keep-wiki", action="store_true",
                    help="leave the wiki enabled (standard: off)")
    sp.add_argument("--keep-projects", action="store_true",
                    help="leave Projects enabled (standard: off)")
    sp.add_argument("--keep-discussions", action="store_true",
                    help="leave Discussions enabled (standard: off)")
    sp.add_argument("--required-check", action="append", default=[],
                    help="status-check context the ruleset requires "
                         "(repeatable; default: the template's — the "
                         "gate workflow's 'gate / gate')")
    sp.add_argument("--bypass-user-id", type=int, default=None,
                    help="variant B: numeric GitHub user id for the "
                         "ruleset bypass list (pull-request mode, per "
                         "the standard); default: resolved "
                         "automatically from the authenticated gh user")
    args = ap.parse_args(argv)
    tooling = os.path.abspath(args.tooling)
    if not os.path.isdir(os.path.join(tooling, "templates")):
        say(f"tooling checkout not found at {tooling}")
        return 2
    if args.command == "setup":
        return cmd_setup(tooling, args)
    if args.command == "env":
        return cmd_env(tooling, args)
    if args.command == "provision":
        return cmd_provision(tooling, args)
    if args.command == "packet":  # unreachable: handled in main()
        return 2
    repo = os.path.abspath(args.repo)
    if args.command == "init":
        cmd_init(tooling, repo)
    else:
        install_hooks(tooling, repo)
    return 0


if __name__ == "__main__":
    sys.exit(main())
