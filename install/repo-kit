BLOCK_BEGIN = "# >>> repo-tooling"
BLOCK_END = "# <<< repo-tooling"


def say(msg):
    # flush: the pattern-service launcher prints the client env
    # block and then runs a foreground child — under a pipe or a
    # captured log the block must not sit in a buffer the child
    # outlives (or a kill loses).
    print(f"repo-kit: {msg}", flush=True)


def copy_if_absent(src, dst, label):
    if os.path.exists(dst):
        say(f"skip {label} (exists — project content is never overwritten)")
        return False
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    shutil.copyfile(src, dst)
    say(f"wrote {label}")
    return True


def merge_gitignore(tooling, repo):
    block = open(os.path.join(tooling, "templates", "gitignore.block"),
                 encoding="utf-8").read().strip("\n")
    path = os.path.join(repo, ".gitignore")
    existing = ""
    if os.path.exists(path):
        existing = open(path, encoding="utf-8").read()
    if BLOCK_BEGIN in existing and BLOCK_END not in existing:
        # A dangling begin marker (an interrupted edit or a
        # hand-trimmed block): remove ONLY the marker line and
        # keep every other line the user wrote, then fall through
        # to append a fresh block (v0.4.8, pass 4 — the old code
        # appended a second block, and the NEXT run partitioned
        # across the whole span between the dangling begin and
        # the appended end, silently dropping the user content
        # in between).
        existing = "\n".join(
            ln for ln in existing.split("\n")
            if not ln.startswith(BLOCK_BEGIN))
    if BLOCK_BEGIN in existing and BLOCK_END in existing:
        head, _, rest = existing.partition(BLOCK_BEGIN)
        _, _, tail = rest.partition(BLOCK_END)
        merged = head.rstrip("\n") + "\n\n" + block + \
            (("\n" + tail) if tail.strip("\n") else "\n")
        action = "refreshed tooling block in"
    elif existing.strip():
        merged = existing.rstrip("\n") + "\n\n" + block + "\n"
        action = "appended tooling block to"
    else:
        merged = block + "\n"
        action = "created"
    if merged != existing:
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(merged)
        say(f"{action} .gitignore")
    else:
        say(".gitignore tooling block unchanged")


def install_hooks(tooling, repo):
    # --git-common-dir, not --git-dir (v0.4.8, pass 4): in a
    # linked worktree or a submodule, --git-dir names the
    # worktree's private git dir, whose hooks/ git never reads —
    # the hook landed where it could never run. The common dir
    # is the main .git for every worktree of the repo.
    git_dir = subprocess.run(
        ["git", "-C", repo, "rev-parse", "--git-common-dir"],
        capture_output=True, text=True)
    if git_dir.returncode != 0:
        say("not a git repo — run `git init` first; hooks skipped")
        return
    hooks_dir = os.path.join(repo, git_dir.stdout.strip(), "hooks")
    os.makedirs(hooks_dir, exist_ok=True)
    dst = os.path.join(hooks_dir, "pre-push")
    src_text = open(os.path.join(tooling, "hooks", "pre-push"),
                    encoding="utf-8").read()
    # The baked path lands inside a double-quoted shell string
    # in the dispatcher (TOOLING_HOME="..."): escape the four
    # characters that stay special there, so a checkout path
    # containing a quote, a $ or a backtick cannot break out of
    # the assignment (v0.4.8, pass 4).
    baked_path = os.path.abspath(tooling)
    for ch in ("\\", '"', "$", "`"):
        baked_path = baked_path.replace(ch, "\\" + ch)
    baked = src_text.replace("__TOOLING_HOME__", baked_path)
    if os.path.exists(dst):
        current = open(dst, encoding="utf-8").read()
        if "repo-tooling pre-push dispatcher" not in current:
            say("REFUSED: .git/hooks/pre-push exists and is not the "
                "repo-tooling dispatcher — merge it by hand, not replaced")
            return
        if current == baked:
            say("pre-push hook unchanged")
            return
    with open(dst, "w", encoding="utf-8") as fh:
        fh.write(baked)
    os.chmod(dst, 0o755)
    say("installed .git/hooks/pre-push (dispatcher)")


def _ask(prompt):
    """One interactive answer, or None when the input ENDED
    (EOF — a closed stdin, Ctrl-D). None is distinct from an
    empty answer (v0.4.8, pass 4): a caller collecting answers
    that shape a file must be able to tell "the user skipped
    this" from "there is no user" — the old code returned ""
    for both, and setup's broad defaults read "" as yes."""
    try:
        return input(prompt).strip()
    except EOFError:
        return None


def _ask_list(prompt):
    raw = _ask(prompt)
    if raw is None:
        return None
    return [v.strip() for v in raw.split(",") if v.strip()]


def _count_patterns(path):
    return sum(1 for ln in open(path, encoding="utf-8")
               if ln.strip() and not ln.strip().startswith("#"))


def _tier_for_path_fallback(path):
    """Local implementation of gate_common.tier_for_path — the
    same rule (v0.4.8 fix pass, secondary review item 14), used
    only when gate_common could not be imported, so the alias
    below never needs the module at import time."""
    base = os.path.basename(path or "")
    if base == "patterns-relaxed.txt":
        return "relaxed"
    if base == "patterns-strict.txt":
        return "strict"
    return os.path.splitext(base)[0] or "patterns"


