#!/usr/bin/env python3
"""repo-kit — the repo-tooling installer. ONE entry point, two jobs:

    repo-kit init  [--tooling PATH] [REPO]
        Scaffold a repo from the tooling templates: PLAN.md,
        project.public.yaml, CONTRIBUTING.md, adr/ format files and the
        thin caller workflows — copying ONLY what belongs in a project
        repo — then merge the tooling block into .gitignore and install
        the hooks. Existing project CONTENT files are never overwritten;
        managed files (workflows) are only written when absent, so
        re-running init is safe and reports what it skipped.

    repo-kit hooks [--tooling PATH] [REPO]
        Install/refresh .git/hooks/pre-push (the dispatcher). This is
        also the "update" path for local checks: the dispatcher reads
        the tooling checkout at push time, so new checks added to the
        toolkit apply as soon as the tooling checkout is updated.

    repo-kit setup [--tooling PATH] [--force] [answer flags]
        Guided questionnaire that builds your private patterns.txt in
        the tooling checkout root (see "Your pattern list" in the
        tooling README). Interactive prompts with detected defaults
        (your OS username, home paths); every prompt has a matching
        flag (--email, --domain, --handle, --name, --age-key,
        --no-paths, --no-gmail, --no-tailnet) so the same setup is
        scriptable and testable. Refuses to overwrite an existing
        patterns.txt without --force.

--tooling names a local tooling checkout in v0.1; fetching templates
from a git URL (sparse checkout of templates/ + install/ + hooks/) is
the planned distribution once the tooling repo is published.
"""

import argparse
import getpass
import os
import re
import shutil
import subprocess
import sys

CONTENT_FILES = ["PLAN.md", "project.public.yaml", "CONTRIBUTING.md"]
ADR_FILES = ["adr/ADR-FORMAT.md", "adr/ADR-000-template.json"]
WORKFLOW_FILES = ["dashboard.yml", "gate.yml"]
BLOCK_BEGIN = "# >>> repo-tooling"
BLOCK_END = "# <<< repo-tooling"


def say(msg):
    print(f"repo-kit: {msg}")


def copy_if_absent(src, dst, label):
    if os.path.exists(dst):
        say(f"skip {label} (exists — project content is never overwritten)")
        return False
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    shutil.copyfile(src, dst)
    say(f"wrote {label}")
    return True


def merge_gitignore(tooling, repo):
    block = open(os.path.join(tooling, "templates", "gitignore.block"),
                 encoding="utf-8").read().strip("\n")
    path = os.path.join(repo, ".gitignore")
    existing = ""
    if os.path.exists(path):
        existing = open(path, encoding="utf-8").read()
    if BLOCK_BEGIN in existing and BLOCK_END in existing:
        head, _, rest = existing.partition(BLOCK_BEGIN)
        _, _, tail = rest.partition(BLOCK_END)
        merged = head.rstrip("\n") + "\n\n" + block + \
            (("\n" + tail) if tail.strip("\n") else "\n")
        action = "refreshed tooling block in"
    elif existing.strip():
        merged = existing.rstrip("\n") + "\n\n" + block + "\n"
        action = "appended tooling block to"
    else:
        merged = block + "\n"
        action = "created"
    if merged != existing:
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(merged)
        say(f"{action} .gitignore")
    else:
        say(".gitignore tooling block unchanged")


def install_hooks(tooling, repo):
    git_dir = subprocess.run(
        ["git", "-C", repo, "rev-parse", "--git-dir"],
        capture_output=True, text=True)
    if git_dir.returncode != 0:
        say("not a git repo — run `git init` first; hooks skipped")
        return
    hooks_dir = os.path.join(repo, git_dir.stdout.strip(), "hooks")
    os.makedirs(hooks_dir, exist_ok=True)
    dst = os.path.join(hooks_dir, "pre-push")
    src_text = open(os.path.join(tooling, "hooks", "pre-push"),
                    encoding="utf-8").read()
    baked = src_text.replace("__TOOLING_HOME__", os.path.abspath(tooling))
    if os.path.exists(dst):
        current = open(dst, encoding="utf-8").read()
        if "repo-tooling pre-push dispatcher" not in current:
            say("REFUSED: .git/hooks/pre-push exists and is not the "
                "repo-tooling dispatcher — merge it by hand, not replaced")
            return
        if current == baked:
            say("pre-push hook unchanged")
            return
    with open(dst, "w", encoding="utf-8") as fh:
        fh.write(baked)
    os.chmod(dst, 0o755)
    say("installed .git/hooks/pre-push (dispatcher)")


def _ask(prompt):
    try:
        return input(prompt).strip()
    except EOFError:
        return ""


def _ask_list(prompt):
    raw = _ask(prompt)
    return [v.strip() for v in raw.split(",") if v.strip()]


def cmd_setup(tooling, args):
    out = os.path.join(tooling, "patterns.txt")
    if os.path.exists(out) and not args.force:
        say("patterns.txt already exists in the tooling checkout — "
            "refusing to overwrite it. Edit it directly, or re-run "
            "with --force to replace it.")
        return 1
    user = getpass.getuser()
    interactive = not any([args.email, args.domain, args.handle,
                           args.name, args.age_key])
    emails, domains, handles, names = (
        list(args.email), list(args.domain), list(args.handle),
        list(args.name))
    age_key = args.age_key
    want_gmail, want_tailnet, want_paths = (
        not args.no_gmail, not args.no_tailnet, not args.no_paths)
    if interactive:
        print("repo-kit setup — your private pattern list.")
        print("Answer what applies; press Enter to skip a question. "
              "Values become patterns in patterns.txt (tooling root, "
              "git-ignored). Nothing is uploaded anywhere.\n")
        emails = _ask_list("Your email addresses (comma-separated): ")
        domains = _ask_list(
            "Domains you own, to block any address at them "
            "(comma-separated): ")
        want_gmail = _ask(
            "Also block ANY @gmail.com address in your repos? [Y/n] "
            ).lower() not in ("n", "no")
        handles = _ask_list(
            "Your usernames/handles on other services "
            "(comma-separated): ")
        names = _ask_list(
            "Names unique to your setup — cloud project IDs, drive or "
            "server names (comma-separated): ")
        want_paths = _ask(
            f"Block your home paths (/Users/{user}/ and "
            f"/home/{user}/)? [Y/n] ").lower() not in ("n", "no")
        want_tailnet = _ask(
            "Block Tailscale tailnet names (*.ts.net)? [Y/n] "
            ).lower() not in ("n", "no")
        age_key = _ask(
            "A sops age PUBLIC key (age1…), if you use one — it is an "
            "identifier uniquely yours (Enter to skip): ") or None

    lines = ["# patterns.txt — MY private pattern list.",
             "# Built by `repo-kit setup`. Edit freely: one regex per "
             "line,",
             "# # starts a comment, matching is case-insensitive.",
             "# NEVER commit this file anywhere (the tooling repo's",
             "# .gitignore covers it here). For CI, paste its contents",
             "# into the GATE_PATTERNS repository secret.", ""]
    pats = []

    def add(section, values):
        if values:
            lines.append(f"# {section}")
            lines.extend(values)
            lines.append("")
            pats.extend(values)

    add("Email addresses (mine)",
        [re.escape(e) for e in emails])
    add("My domains — any address at them",
        [r"[\w.+-]+@" + re.escape(d) for d in domains])
    if want_gmail:
        add("Webmail catch-all", [r"[\w.+-]+@gmail\.com"])
    add("Handles / usernames", [re.escape(h) for h in handles])
    add("My infrastructure names (cloud projects, drives, servers)",
        [re.escape(n) for n in names])
    if want_paths:
        add("My machine paths",
            [f"/Users/{user}/", f"/home/{user}/"])
    if want_tailnet:
        add("Tailnet names", [r"[a-z0-9-]+\.ts\.net"])
    if age_key:
        add("My age public key (identifier)", ["age1[a-z0-9]{58}"]
            if not age_key.startswith("age1") else [re.escape(age_key)])

    bad = []
    for p in pats:
        try:
            re.compile(p, re.IGNORECASE)
        except re.error as exc:
            bad.append(f"{p}: {exc}")
    if bad:
        say("these generated patterns do not compile — nothing written:")
        for b in bad:
            print(f"  {b}")
        return 1
    with open(out, "w", encoding="utf-8") as fh:
        fh.write("\n".join(lines))
    # Standard closing summary for every guided setup (pattern agreed
    # 2026-11-12): say what was written, WHERE it lives, that it can be
    # edited by hand anytime, and the one next step if there is one.
    print()
    print("=" * 64)
    print("Setup complete.")
    print(f"  Wrote:    {out} ({len(pats)} patterns)")
    print("  What reads it: the pre-push checks and (via the secret "
          "below) CI.")
    print("  Edit it anytime: it's a plain text file — one regex per "
          "line,")
    print("  # for comments. Your edits take effect on the next check; "
          "no need")
    print("  to re-run setup. Re-running setup replaces it (with "
          "--force).")
    print("  Keep it private: it stays out of git (the tooling repo's "
          ".gitignore")
    print("  covers it) — never copy it into a project repo.")
    print("  Next step: in each project repo, add a secret named "
          "GATE_PATTERNS")
    print("  with this file's contents, so CI enforces the same list.")
    print("=" * 64)
    return 0


ENV_TOOLS = [
    ("gitleaks", ["gitleaks", "version"], "secret scanning"),
    ("shellcheck", ["shellcheck", "--version"], "shell script linting"),
    ("zizmor", ["zizmor", "--version"], "Actions workflow security lint"),
    ("actionlint", ["actionlint", "--version"], "Actions workflow lint"),
    ("check-merge-conflict", ["check-merge-conflict", "--help"],
     "file hygiene (pre-commit-hooks package)"),
    ("python3", ["python3", "--version"], "renderer + checks runtime"),
]


def cmd_env(tooling, args):
    """Environment report + optional bulk hook install.

    Designed to be callable from a dev container's entrypoint: fast,
    idempotent, and fail-open (exit 0) unless --strict — a tooling
    problem must never stop the user's shell from starting.
    """
    print("repo-kit env — tooling status")
    for name, cmd, role in ENV_TOOLS:
        path = shutil.which(cmd[0])
        if not path:
            print(f"  MISSING  {name} ({role}) — checks that need it "
                  "skip loudly")
            continue
        try:
            out = subprocess.run(cmd, capture_output=True, text=True,
                                 timeout=10)
            ver = (out.stdout or out.stderr).strip().splitlines()
            ver = ver[0] if ver else "ok"
        except Exception as exc:  # noqa: BLE001 — report, never crash env
            ver = f"present but errored: {exc}"
        print(f"  ok       {name}: {ver}")
    pats = os.path.join(tooling, "patterns.txt")
    if os.path.exists(pats):
        n = sum(1 for ln in open(pats, encoding="utf-8")
                if ln.strip() and not ln.startswith("#"))
        print(f"  patterns.txt: present ({n} patterns)")
    else:
        print("  patterns.txt: ABSENT — run `repo-kit setup`")
    if args.hooks_root:
        root = os.path.abspath(args.hooks_root)
        found = []
        for dirpath, dirnames, _ in os.walk(root):
            if ".git" in dirnames:
                found.append(dirpath)
                dirnames[:] = []  # don't descend into a repo
            if dirpath[len(root):].count(os.sep) > 3:
                dirnames[:] = []
        if not found:
            print(f"  hooks: no git repos found under {root}")
        for repo in sorted(found):
            print(f"  hooks -> {repo}")
            install_hooks(tooling, repo)
    return 0


def cmd_init(tooling, repo):
    for rel in CONTENT_FILES + ADR_FILES:
        copy_if_absent(os.path.join(tooling, "templates", rel),
                       os.path.join(repo, rel), rel)
    for name in WORKFLOW_FILES:
        copy_if_absent(
            os.path.join(tooling, "templates", "workflows", name),
            os.path.join(repo, ".github", "workflows", name),
            f".github/workflows/{name}")
    merge_gitignore(tooling, repo)
    install_hooks(tooling, repo)
    say("done. Next: edit project.public.yaml + PLAN.md, add the "
        "GATE_PATTERNS repo secret, enable Pages (source: GitHub Actions).")


def main(argv=None):
    default_tooling = os.path.dirname(os.path.dirname(
        os.path.abspath(__file__)))
    ap = argparse.ArgumentParser(description=__doc__)
    sub = ap.add_subparsers(dest="command", required=True)
    for name in ("init", "hooks"):
        sp = sub.add_parser(name)
        sp.add_argument("repo", nargs="?", default=".")
        sp.add_argument("--tooling", default=default_tooling)
    sp = sub.add_parser("env")
    sp.add_argument("--tooling", default=default_tooling)
    sp.add_argument("--hooks-root",
                    help="install/refresh hooks in every git repo under "
                         "this directory (dev-container entrypoint use)")
    sp = sub.add_parser("setup")
    sp.add_argument("--tooling", default=default_tooling)
    sp.add_argument("--force", action="store_true",
                    help="replace an existing patterns.txt")
    sp.add_argument("--email", action="append", default=[])
    sp.add_argument("--domain", action="append", default=[])
    sp.add_argument("--handle", action="append", default=[])
    sp.add_argument("--name", action="append", default=[])
    sp.add_argument("--age-key", default=None)
    sp.add_argument("--no-gmail", action="store_true")
    sp.add_argument("--no-tailnet", action="store_true")
    sp.add_argument("--no-paths", action="store_true")
    args = ap.parse_args(argv)
    tooling = os.path.abspath(args.tooling)
    if not os.path.isdir(os.path.join(tooling, "templates")):
        say(f"tooling checkout not found at {tooling}")
        return 2
    if args.command == "setup":
        return cmd_setup(tooling, args)
    if args.command == "env":
        return cmd_env(tooling, args)
    repo = os.path.abspath(args.repo)
    if args.command == "init":
        cmd_init(tooling, repo)
    else:
        install_hooks(tooling, repo)
    return 0


if __name__ == "__main__":
    sys.exit(main())
